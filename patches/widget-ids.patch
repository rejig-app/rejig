 def normalize_for_write(item: Any) -> Any:
     """Upgrade legacy ``iconType: folder`` folders to ``listType: folder``.
 
-    SpringBoard silently drops folders written with ``iconType: folder``.
+    SpringBoard silently drops folders written with ``iconType: folder``. A configured
+    single widget shows its element id only as ``userSelectedElementIdentifier``; it is
+    written back as ``uniqueIdentifier`` too, or SpringBoard gives the widget a new id and
+    its settings are lost. In a stack that key names the element on show, so stacks keep
+    theirs as read.
     """
     if not isinstance(item, Mapping):
         return deepcopy(item)
     result = deepcopy(dict(item))
+    if _single_widget(result) and not result.get("uniqueIdentifier"):
+        chosen = result.get("userSelectedElementIdentifier")
+        if isinstance(chosen, str) and chosen:
+            result["uniqueIdentifier"] = chosen
     if is_folder(result):
         result.pop("iconType", None)
         result["listType"] = "folder"
