+class _ReadbackWidgetId:
+    """A single widget's id as a re-read can show it: ``uniqueIdentifier``, else its alias
+    ``userSelectedElementIdentifier``, else nothing (iOS drops it from some reads).
+
+    A missing id matches anything; two ids must be equal.
+    """
+
+    __hash__ = None  # type: ignore[assignment]
+
+    def __init__(self, item: Mapping[str, Any]) -> None:
+        ids = (item.get("uniqueIdentifier"), item.get("userSelectedElementIdentifier"))
+        self.id = next((x for x in ids if isinstance(x, str) and x), None)
+
+    def __eq__(self, other: object) -> bool:
+        return isinstance(other, _ReadbackWidgetId) and (
+            self.id is None or other.id is None or self.id == other.id
+        )
+
+
