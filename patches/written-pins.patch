+class PinStore:
+    """Rejig: per phone (UDID), the gaps Rejig placed, as :func:`~..state.pin_record` records.
+
+    A read cannot show gaps, so this file is the only memory of them. It changes only once
+    a write resolves. While the file is damaged, or the last save failed, writes are
+    refused so stale gaps are never sent.
+    """
+
+    def __init__(self, path: Path) -> None:
+        self.path = path
+        self._records: dict[str, Any] | None = None
+        self.damaged: str | None = None
+        self.unsaved = False
+
+    def _load(self) -> dict[str, Any]:
+        if self._records is None:
+            try:
+                data = json.loads(self.path.read_text(encoding="utf-8"))
+            except FileNotFoundError:
+                data = {}
+            except (OSError, ValueError) as exc:
+                self.damaged, data = str(exc), {}
+            if not isinstance(data, dict) or not all(
+                isinstance(k, str) and _valid_record(v) for k, v in data.items()
+            ):
+                self.damaged, data = self.damaged or "unexpected contents", {}
+            self._records = data
+        return self._records
+
+    def get(self, udid: str | None) -> Any:
+        return self._load().get(udid) if udid else None
+
+    def put(self, udid: str, record: list[dict[str, Any]] | None) -> None:
+        records = dict(self._load())
+        if record:
+            records[udid] = record
+        else:
+            records.pop(udid, None)
+        self._records = records
+        self.unsaved = True
+        self._save()
+
+    def _save(self) -> None:
+        try:
+            self.path.parent.mkdir(parents=True, exist_ok=True)
+            temp = self.path.with_name(f".{self.path.name}.tmp")
+            temp.write_text(json.dumps(self._records, indent=1, sort_keys=True), encoding="utf-8")
+            os.replace(temp, self.path)
+        except OSError as exc:
+            raise PinStoreError(
+                f"Rejig could not save where the gaps it placed are ({self.path}): {exc}. "
+                "Nothing more is written until it can."
+            ) from exc
+        self.unsaved = False
+
+    def check_writable(self) -> None:
