+def page_key(page: Iterable[Any]) -> str:
+    """Rejig: SHA-256 of one page's items and order, the way :func:`fingerprint` sees them."""
+    text = json.dumps([_canonical_item(item) for item in page], ensure_ascii=False, separators=(",", ":"))
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
