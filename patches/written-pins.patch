+def pin_record(state: State, pins: Any) -> list[dict[str, Any]]:
+    """Rejig: the pins a write left on the phone, each bound to its page as ``state`` (the
+    read that verified the write) shows it: ``[{"key": page_key, "pins": {id: cell}}]``."""
+    _, pages = split_state(state)
+    return [
+        {"key": page_key(page), "pins": dict(page_pins)}
+        for page, page_pins in zip(pages, pins or [])
+        if page_pins
+    ]
+
