+def reconcile_pins(record: Any, state: State) -> list[dict[str, int]] | None:
+    """Rejig: per page of ``state``, the pins of ``record`` still true of it; ``None`` if none.
+
+    Reads never show pins, so a page keeps its pins only while it reads back exactly as
+    written (same items in the same order) and they still put it in that order. Any edit
+    on the phone that changes the page drops them.
+    """
+    known: dict[str, dict[str, Any] | None] = {}
+    for entry in record if isinstance(record, list) else []:
+        if isinstance(entry, Mapping) and isinstance(entry.get("key"), str) and isinstance(entry.get("pins"), Mapping):
+            # Two entries for one page are ambiguous: that page keeps no pins.
+            known[entry["key"]] = None if entry["key"] in known else dict(entry["pins"])
+    _, pages = split_state(state)
+    found: list[dict[str, int]] = []
+    for page in pages:
+        pins = known.get(page_key(page)) or {}
+        try:
+            if pins and [item for _, item in place_page(page, pins)] != list(page):
+                pins = {}
+        except StateError:
+            pins = {}
+        found.append(pins)
+    return found if any(found) else None
