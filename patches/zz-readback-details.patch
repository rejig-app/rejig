+def _readback_difference(target: Any, observations: list[dict[str, Any]], installed: Mapping[str, Any]) -> str:
+    reads = [entry["state"] for entry in observations if "state" in entry]
+    if not reads:
+        return "The phone could not be read after the write."
+    wanted, actual = visible_apps(target), visible_apps(reads[-1])
+
+    def names(ids: set[str]) -> str:
+        ordered = sorted(ids)
+        labels = [str((installed.get(i) or {}).get("name") or i) for i in ordered[:8]]
+        return ", ".join(labels) + (f" and {len(ordered) - 8} more" if len(ordered) > 8 else "")
+
+    differences = []
+    if wanted - actual:
+        differences.append("Missing from the Home Screen: " + names(wanted - actual) + ".")
+    if actual - wanted:
+        differences.append("Unexpected on the Home Screen: " + names(actual - wanted) + ".")
+    return " ".join(differences) or "App order, pages, folders or widget configuration differed from the requested layout."
 
 
