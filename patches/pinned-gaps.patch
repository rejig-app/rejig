+# --------------------------------------------------------------------------- pins (gaps)
+
+
+def item_shape(item: Any) -> tuple[int, int]:
+    """(columns, rows) an item covers on the 4x6 grid."""
+    if not is_widget(item):
+        return (1, 1)
+    size = str(item.get("gridSize", "small"))
+    try:
+        return WIDGET_SHAPES[size]
+    except KeyError as exc:
+        raise StateError(f"unknown widget size: {size!r}") from exc
+
+
+def _footprint(cell: int, shape: tuple[int, int]) -> set[int] | None:
+    row, col = divmod(cell, GRID_COLUMNS)
+    width, height = shape
+    if col + width > GRID_COLUMNS or row + height > GRID_ROWS:
+        return None
+    return {(row + r) * GRID_COLUMNS + col + c for r in range(height) for c in range(width)}
+
+
+def _pin_error(message: str) -> StateError:
+    return StateError(message, code="invalid_pins")
+
+
+def place_page(page: list[Any], pins: Mapping[str, Any] | None) -> list[tuple[int, Any]]:
+    """``(cell, item)`` for every item on a page, in screen order.
+
+    Pinned items take their cells; the rest fill the first free cell that fits, row by
+    row, in list order. Only apps and web clips can be pinned (folders have no device
+    id; which id a widget's pin uses is unverified). SpringBoard reads a pinned page back
+    in screen order, so a write must send it in that order or readback fails.
+    """
+    pins = dict(pins or {})
+    taken: set[int] = set()
+    placed: list[tuple[int, Any]] = []
+    pinnable = {}
+    for item in page:
+        if not is_folder(item) and not is_widget(item):
+            pinnable.setdefault(item_id(item), item)
+    unknown = sorted(set(pins) - set(pinnable))
+    if unknown:
+        raise _pin_error("pinned items must be apps or web clips on that page: " + ", ".join(unknown))
+    for ident, cell in pins.items():
+        if isinstance(cell, bool) or not isinstance(cell, int) or not 0 <= cell < PAGE_CELLS:
+            raise _pin_error(f"pin cell for {ident} must be 0-{PAGE_CELLS - 1}, got {cell!r}")
+        if cell in taken:
+            raise _pin_error(f"two items are pinned to cell {cell}")
+        taken.add(cell)
+    pinned_items = {id(pinnable[ident]): cell for ident, cell in pins.items()}
+    for item in page:
+        cell = pinned_items.get(id(item))
+        if cell is not None:
+            placed.append((cell, item))
+            continue
+        shape = item_shape(item)
+        for candidate in range(PAGE_CELLS):
+            cells = _footprint(candidate, shape)
+            if cells is not None and not cells & taken:
+                taken |= cells
+                placed.append((candidate, item))
+                break
+        else:
+            raise _pin_error(f"{item_name(item)} does not fit around the pinned items")
+    return sorted(placed, key=lambda pair: pair[0])
+
+
+def _page_pins(state: Mapping[str, Any], pages: list[list[Any]]) -> list[dict[str, int]] | None:
+    raw = state.get(PINS_KEY)
+    if raw is None:
+        return None
+    if not isinstance(raw, list) or len(raw) != len(pages):
+        raise _pin_error("pins must be a list with one table per page")
+    if any(not isinstance(p, Mapping) or any(not isinstance(k, str) for k in p) for p in raw):
+        raise _pin_error("each page's pins must map item ids to cells")
+    return [dict(p) for p in raw]
+
+
+def wire_payload(payload: Mapping[str, Any]) -> dict[str, Any]:
+    """The ``setIconState`` dictionary: pins become fresh page ids plus ``listMetadata``."""
+    out = {key: payload[key] for key in PAYLOAD_KEYS}
+    pins = payload.get(PINS_KEY)
+    if pins and any(pins):
+        ids = [str(uuid.uuid4()).upper() for _ in out["iconLists"]]
+        out["listUniqueIdentifiers"] = ids
+        out["listMetadata"] = {
+            ids[i]: {
+                "fixedLocations": dict(page_pins),
+                "fixedLocationsGridColumns": GRID_COLUMNS,
+                "fixedLocationsGridRows": GRID_ROWS,
+            }
+            for i, page_pins in enumerate(pins)
+            if page_pins
+        }
+    return out
+
+
+_METADATA_FIELDS = frozenset({"fixedLocations", "fixedLocationsGridColumns", "fixedLocationsGridRows"})
+
+
+def _check_wire_pins(payload: Mapping[str, Any]) -> None:
+    if not WIRE_PIN_KEYS & set(payload):
+        return
+    ids, meta = payload.get("listUniqueIdentifiers"), payload.get("listMetadata")
+    pages = payload["iconLists"]
+    if (
+        not isinstance(ids, list)
+        or len(ids) != len(pages)
+        or any(not isinstance(i, str) or not i for i in ids)
+        or len(set(ids)) != len(ids)
+    ):
+        raise _pin_error("listUniqueIdentifiers must hold one distinct id string per page")
+    if not isinstance(meta, Mapping) or not meta or not set(meta) <= set(ids):
+        raise _pin_error("listMetadata must be keyed by page ids")
+    for page_id, entry in meta.items():
+        if not isinstance(entry, Mapping) or set(entry) != _METADATA_FIELDS:
+            raise _pin_error("listMetadata entries hold exactly fixedLocations and the grid size")
+        size = (entry["fixedLocationsGridColumns"], entry["fixedLocationsGridRows"])
+        if any(isinstance(n, bool) for n in size) or size != (GRID_COLUMNS, GRID_ROWS):
+            raise _pin_error(f"pins are only supported on the {GRID_COLUMNS}x{GRID_ROWS} grid")
+        locations = entry["fixedLocations"]
+        if not isinstance(locations, Mapping) or not locations or any(not isinstance(k, str) for k in locations):
+            raise _pin_error("fixedLocations must map item ids to cells")
+        page = pages[ids.index(page_id)]
+        placed = place_page(page, locations)
+        if [item for _, item in placed] != list(page):
+            raise _pin_error("a pinned page must be sent in screen order")
+
+
